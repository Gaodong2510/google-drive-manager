[Unit]
Description=CloudBridge (云桥) Web Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/google-drive-manager/backend
Environment=GDM_DATA_DIR=/root/google-drive-manager/data
Environment=GDM_HOST=127.0.0.1
Environment=GDM_PORT=8787
# Bind localhost only — public access via nginx HTTPS (drive.dongwen.cc)
ExecStart=/root/google-drive-manager/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3
LimitNOFILE=1048576
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
